# --- Banco e infraestrutura ---
# Se a máquina já roda Postgres/Redis locais, suba a infra em portas alternativas
# (POSTGRES_PORT=55432 REDIS_PORT=56379 MINIO_PORT=59000) e ajuste as URLs abaixo.
DATABASE_URL=postgres://adpub:adpub@localhost:5432/adpub
REDIS_URL=redis://localhost:6379
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=adpub
S3_REGION=us-east-1
S3_ACCESS_KEY=adpubminio
S3_SECRET_KEY=adpubminio123

# --- Cifra de tokens (32 bytes em base64, NUNCA no banco) ---
MASTER_KEY=

# --- Meta ---
META_APP_ID=
META_APP_SECRET=
META_API_VERSION=v25.0
# Só em teste: aponta a Graph API para um duplo local. Produção usa o padrão.
# META_BASE_URL=https://graph.facebook.com
META_TIER=limited

# --- Auth (Google Workspace) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
AUTH_ALLOWED_DOMAIN=empresa.com.br
AUTH_SECRET=
GOOGLE_SERVICE_ACCOUNT_JSON=

# --- IA ---
ANTHROPIC_API_KEY=
AI_MODEL_GENERATION=claude-sonnet-4-6
AI_MODEL_CLASSIFY=claude-haiku-4-6

# --- Alertas (opcional) ---
SLACK_WEBHOOK_URL=

# --- Observabilidade (opcional): vazio = nada é carregado ---
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0
OTEL_EXPORTER_OTLP_ENDPOINT=

# --- Endpoints internos ---
API_PORT=4000
API_URL=http://localhost:4000
WEB_URL=http://localhost:3000
