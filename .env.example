# --- Banco e infraestrutura ---
# Se a máquina já roda Postgres/Redis locais, suba a infra em portas alternativas
# (POSTGRES_PORT=55432 REDIS_PORT=56379 MINIO_PORT=59000) e ajuste as URLs abaixo.
DATABASE_URL=postgres://adpub:adpub@localhost:5432/adpub
REDIS_URL=redis://localhost:6379
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=adpub
S3_REGION=us-east-1
S3_ACCESS_KEY=adpubminio
S3_SECRET_KEY=adpubminio123

# --- Cifra de tokens (32 bytes em base64, NUNCA no banco) ---
MASTER_KEY=

# --- Meta ---
META_APP_ID=
META_APP_SECRET=
META_API_VERSION=v25.0
# Só em teste: aponta a Graph API para um duplo local. Produção usa o padrão.
# META_BASE_URL=https://graph.facebook.com
META_TIER=limited

# --- Auth (e-mail + senha) ---
# Primeiro acesso: POST /api/v1/auth/password/bootstrap cria o admin inicial;
# a rota desliga sozinha quando já há senha. Demais usuários: admin cria em /usuarios.
AUTH_ALLOWED_DOMAIN=empresa.com.br
AUTH_SECRET=
# Opcional: conta de serviço do Drive (importação de criativos), base64 ou JSON.
GOOGLE_SERVICE_ACCOUNT_JSON=

# --- IA ---
ANTHROPIC_API_KEY=
AI_MODEL_GENERATION=claude-sonnet-4-6
AI_MODEL_CLASSIFY=claude-haiku-4-6

# --- Alertas no Telegram (opcional; precisam vir os dois juntos) ---
# Bot criado no @BotFather; chat_id via getUpdates ou @userinfobot.
# TELEGRAM_BOT_TOKEN=123456:AA...
# TELEGRAM_CHAT_ID=-1001234567890

# --- Observabilidade (opcional): vazio = nada é carregado ---
# OTEL_EXPORTER_OTLP_ENDPOINT=

# --- Endpoints internos ---
API_PORT=4000
API_URL=http://localhost:4000
WEB_URL=http://localhost:3000

# --- Servidor MCP (apps/mcp): ferramentas para ChatGPT e afins ---
# URL pública do endpoint MCP; dela saem issuer, resource e metadados OAuth.
MCP_PORT=4100
MCP_PUBLIC_URL=http://localhost:4100/mcp
# Hosts aceitos no header Host (proteção contra DNS rebinding); vazio = só o
# host da URL pública (localhost/127.0.0.1 sempre valem para o healthcheck).
# MCP_ALLOWED_HOSTS=
