{
  "name": "adpub",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "turbo run typecheck && tsc -p tsconfig.scripts.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:generate": "pnpm --filter @adpub/db run generate",
    "db:migrate": "pnpm --filter @adpub/db run migrate",
    "smoke:sandbox": "ADPUB_ALLOW_TRUNCATE=1 tsx scripts/smoke-sandbox.ts",
    "smoke:integration": "ADPUB_ALLOW_TRUNCATE=1 tsx scripts/smoke-integration.ts"
  },
  "devDependencies": {
    "@adpub/ai": "workspace:*",
    "@adpub/api": "workspace:*",
    "@adpub/assets": "workspace:*",
    "@adpub/auth": "workspace:*",
    "@adpub/config": "workspace:*",
    "@adpub/crypto": "workspace:*",
    "@adpub/db": "workspace:*",
    "@adpub/media": "workspace:*",
    "@adpub/meta-client": "workspace:*",
    "@adpub/rules": "workspace:*",
    "@adpub/shared": "workspace:*",
    "@adpub/storage": "workspace:*",
    "@adpub/worker": "workspace:*",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.5.0",
    "bullmq": "^6.3.4",
    "eslint": "^10.10.0",
    "eslint-config-next": "^16.3.4",
    "ioredis": "^6.0.0",
    "pino": "^10.3.1",
    "prettier": "^3.9.6",
    "sharp": "^0.35.4",
    "tsx": "^4.23.13",
    "turbo": "^2.10.12",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.0"
  }
}
