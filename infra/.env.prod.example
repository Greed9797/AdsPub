# Variáveis da produção (docs/deploy.md). Copie para `.env.prod` NO SERVIDOR
# (nunca no repositório) e preencha. O compose usa este mesmo arquivo para
# interpolar os valores e para o ambiente de api/worker; a UI recebe só o que
# está mapeado no serviço `web`.
#
#   cp .env.prod.example .env.prod && chmod 600 .env.prod

# --- Domínios ---------------------------------------------------------------
# TLS é do Caddy do stack `mcrm` (dono das portas 80/443); as rotas deste app
# vão em `Caddyfile.snippet`, que o deploy leva para /opt/adpub.
#
# Sem domínio próprio ainda? O `sslip.io` resolve qualquer host que embuta o IP
# do servidor — dá TLS válido sem tocar no DNS. Troque pelos domínios reais
# (dois registros A) e atualize o snippet quando eles existirem.
APP_DOMAIN=adpub.179-198-104-210.sslip.io
S3_DOMAIN=adpub-s3.179-198-104-210.sslip.io

# --- Servidor MCP (ChatGPT) -------------------------------------------------
# Nada a preencher: o serviço `mcp` do compose deriva tudo de APP_DOMAIN
# (MCP_PUBLIC_URL = https://APP_DOMAIN/mcp). Detalhes em docs/mcp.md — inclusive
# como substituir o bloco do Caddy quando o snippet ganhar as rotas /mcp.

# --- Rede do proxy ----------------------------------------------------------
# Rede docker do Caddy do `mcrm`. Só mude se o stack dele usar outro nome.
PROXY_NETWORK=mcrm_internal

# --- Imagens (GHCR) ---------------------------------------------------------
# IMAGE_PREFIX = ghcr.io/<orgaúsculo> (o workflow publica adpub-api/worker/web).
# IMAGE_TAG é o sha do commit; o deploy do CI exporta o valor — fixe um sha
# aqui só para rollback manual.
# Construindo no próprio host (infra/deploy-host.sh), o prefixo é local: use
# algo como `adpub` — o script exporta IMAGE_PREFIX/IMAGE_TAG por conta própria.
IMAGE_PREFIX=ghcr.io/sua-org
IMAGE_TAG=latest

# --- Postgres ---------------------------------------------------------------
# openssl rand -hex 24 (hex não quebra a URL do banco)
POSTGRES_PASSWORD=

# --- MinIO (storage S3-compatível) ------------------------------------------
MINIO_ROOT_USER=adpub
# openssl rand -hex 24
MINIO_ROOT_PASSWORD=
S3_BUCKET=adpub
S3_REGION=us-east-1

# --- Cifra dos tokens da Meta (Constituição IV) -----------------------------
# openssl rand -base64 32 — 32 bytes em base64, fora do banco.
# Trocar depois invalida todos os tokens já cifrados (é preciso reconectar).
MASTER_KEY=

# --- Auth (Google Workspace) ------------------------------------------------
# openssl rand -hex 32
AUTH_SECRET=
AUTH_ALLOWED_DOMAIN=suaempresa.com.br
# OAuth client do Google Cloud com redirect URI
# https://APP_DOMAIN/api/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Opcional: conta de serviço do Drive (importação de criativos), base64 ou JSON.
GOOGLE_SERVICE_ACCOUNT_JSON=

# --- Meta (Marketing API) ---------------------------------------------------
META_APP_ID=
META_APP_SECRET=
META_API_VERSION=v25.0
# limited durante o piloto; full depois do App Review.
META_TIER=limited

# --- IA ---------------------------------------------------------------------
ANTHROPIC_API_KEY=
AI_MODEL_GENERATION=claude-sonnet-4-6
AI_MODEL_CLASSIFY=claude-haiku-4-6

# --- Flags e logs (rollback de área nova = desligar e reiniciar) ------------
FEATURE_AI_ANALYSIS=1
FEATURE_REPORTS=1
FEATURE_INSIGHTS=1
LOG_LEVEL=info

# --- Opcionais (deixe COMENTADO o que não usar: `.url().optional()` rejeita
# string vazia e o boot falha) -------------------------------------------------
# Alertas no Telegram (R17): bot do @BotFather + chat_id; os dois juntos.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# Rastros OpenTelemetry (sem endpoint, nenhum SDK é carregado).
# OTEL_EXPORTER_OTLP_ENDPOINT=
