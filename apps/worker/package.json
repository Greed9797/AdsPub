{
  "name": "@adpub/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@adpub/ai": "workspace:*",
    "@adpub/analytics": "workspace:*",
    "@adpub/assets": "workspace:*",
    "@adpub/config": "workspace:*",
    "@adpub/creative-intel": "workspace:*",
    "@adpub/crypto": "workspace:*",
    "@adpub/db": "workspace:*",
    "@adpub/media": "workspace:*",
    "@adpub/meta-client": "workspace:*",
    "@adpub/rules": "workspace:*",
    "@adpub/shared": "workspace:*",
    "@adpub/storage": "workspace:*",
    "@adpub/telemetry": "workspace:*",
    "bullmq": "^6.3.4",
    "googleapis": "^178.0.0",
    "ioredis": "^6.0.0",
    "pino": "^10.3.1",
    "postgres": "^3.4.9",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^26.5.0",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  }
}
